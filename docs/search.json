---
layout: null
permalink: /search.json
---
[
{%- assign searchable = site.pages | where_exp: "p", "p.name != 'search.json'" -%}
{%- for p in searchable %}
  {
    "title": {{ p.title | default: p.name | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "content": {{ p.content | strip_html | jsonify }},
    "tags": {{ p.tags | jsonify }},
    "date": {% if p.date %}{{ p.date | date: "%Y-%m-%d" | jsonify }}{% else %}null{% endif %}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
